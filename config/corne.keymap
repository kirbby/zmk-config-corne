#include "keys_de.h"
#include "keys_mac_de_at.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <6>; };

&nice_view_spi { cs-gpios = <&pro_micro 0 GPIO_ACTIVE_HIGH>; };

&lt { flavor = "hold-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        ESC_KL {
            bindings = <&kp ESC>;
            key-positions = <20 21>;
        };

        UE {
            bindings = <&kp DE_U_UMLAUT>;
            key-positions = <3 7>;
        };

        AE {
            bindings = <&kp DE_A_UMLAUT>;
            key-positions = <13 3>;
        };

        OE {
            bindings = <&kp DE_O_UMLAUT>;
            key-positions = <3 9>;
        };

        SS {
            bindings = <&kp DE_SZ>;
            key-positions = <14 19>;
        };

        Tab_DF {
            bindings = <&kp TAB>;
            key-positions = <15 16>;
        };

        GUI_SDF {
            bindings = <&kp LEFT_GUI>;
            key-positions = <14 15 16>;
        };

        ESC_SD {
            bindings = <&kp ESCAPE>;
            key-positions = <14 15>;
        };

        DEL_AF {
            bindings = <&kp DELETE>;
            key-positions = <13 16>;
        };

        CTRL_JL {
            bindings = <&kp RCTRL>;
            key-positions = <21 19>;
            layers = <0>;
        };

        CMD_JL {
            bindings = <&kp LEFT_GUI>;
            key-positions = <21 19>;
            layers = <1>;
        };

        GUI_JKL {
            bindings = <&kp LEFT_GUI>;
            key-positions = <19 20 21>;
        };

        new_ai_chat {
            bindings = <&new_ai_chat>;
            key-positions = <31 32>;
        };
    };

    macros {
        shift_win: shift_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LS(LEFT_WIN)>;

            label = "SHIFT_WIN";
        };

        kill_node: kill_node {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LS(LC(C)))>;
            label = "KILL_NODE";
        };

        alt_F1: find_file_in_explorer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(F1)>;
            label = "FIND_FILE_IN_EXPLORER";
        };

        alt_F4: alt_F4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(F4)>;
            label = "ALT_F4";
        };

        browser_inspect: browser_inspect {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(C))>;
            label = "BROWSER_INSPECT";
        };

        new_ai_chat: new_ai_chat {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LA(I)>,
                <&macro_pause_for_release>,
                <&kp LA(INSERT)>;

            label = "NEW_AI_CHAT";
        };

        new_scratch_file: new_scratch_file {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LC(INSERT)))>;
            label = "NEW_SCRATCH_FILE";
        };

        switch_mac: switch_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            /* ZMK profiles are zero-indexed: BT_SEL 1 is displayed profile 2. */
            bindings = <&bt BT_SEL 1>, <&to 1>;
            label = "SWITCH_MAC";
        };

        switch_win: switch_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            /* ZMK profiles are zero-indexed: BT_SEL 2 is displayed profile 3. */
            bindings = <&bt BT_SEL 2>, <&to 0>;
            label = "SWITCH_WIN";
        };
    };

    behaviors {
        shift_triple_capslock: shift_triple_capslock {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_TRIPLE_CAPSLOCK";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT>, <&kp LSHIFT>, <&kp CAPS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp TAB               &kp Q     &kp W  &kp E      &kp R      &kp T          &kp DE_Z         &kp U                   &kp I         &kp O       &kp DE_O_UMLAUT  &kp DEL
&mt LEFT_ALT LA(TAB)  &kp A     &kp S  &kp D      &kp F      &kp G          &kp H            &kp J                   &kp K         &kp L       &kp P            &kp RIGHT_ALT
&kp LEFT_SHIFT        &kp DE_Y  &kp X  &kp C      &kp V      &kp B          &kp N            &kp M                   &kp COMMA     &kp PERIOD  &kp DE_MINUS     &kp RIGHT_WIN
                                       &kp LCTRL  &kp SPACE  &lt 3 ENTER    &lt 2 BACKSPACE  &shift_triple_capslock  &kp LEFT_ALT
            >;
        };

        Mac_Base {
            bindings = <
&kp TAB               &kp Q     &kp W  &kp E      &kp R      &kp T          &kp DE_Z         &kp U                   &kp I         &kp O       &kp DE_O_UMLAUT  &kp DEL
&mt LEFT_ALT LA(TAB)  &kp A     &kp S  &kp D      &kp F      &kp G          &kp H            &kp J                   &kp K         &kp L       &kp P            &kp RIGHT_ALT
&kp LEFT_SHIFT        &kp DE_Y  &kp X  &kp C      &kp V      &kp B          &kp N            &kp M                   &kp COMMA     &kp PERIOD  &kp DE_MINUS     &kp RCTRL
                                       &kp LEFT_GUI  &kp SPACE  &lt 3 ENTER    &lt 5 BACKSPACE  &shift_triple_capslock  &kp LEFT_ALT
            >;
        };

        Symbols {
            bindings = <
&none  &none        &kp DE_LESS_THAN         &kp DE_GREATER_THAN       &kp DE_EXCLAMATION  &kp DE_PERCENT    &kp DE_GRAVE          &kp DE_QUESTION      &kp DE_LEFT_BRACKET  &kp DE_RIGHT_BRACKET  &none         &none
&none  &kp DE_AT    &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_EQUAL        &kp DE_PIPE       &kp DE_AMPERSAND      &kp DE_PLUS          &kp DE_LEFT_BRACE    &kp DE_RIGHT_BRACE    &kp DE_MINUS  &none
&none  &kp DE_EURO  &kp DE_BACKSLASH         &kp DE_SLASH              &kp DE_ASTERISK     &kp DE_DOLLAR     &kp DE_DOUBLE_QUOTES  &kp DE_SINGLE_QUOTE  &kp DE_TILDE         &kp DE_CARET          &kp DE_HASH   &none
                                             &trans                    &trans              &trans            &trans                &trans               &trans
            >;
        };

        Numbers {
            bindings = <
&kp F2      &kp F10  &kp F11           &kp UP    &kp F3      &kp F12    &kp HOME  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &new_scratch_file  &kp PRINTSCREEN
&alt_F4     &kp F7   &kp LEFT          &kp DOWN  &kp RIGHT   &kp F6     &kp END   &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp F5             &none
&kill_node  &kp F4   &browser_inspect  &alt_F1   &kp DELETE  &kp F8     &kp N0    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp INSERT         &kp RSHIFT
                                       &trans    &shift_win  &trans     &trans    &kp LCTRL     &kp NUMBER_0
            >;
        };

        Settings {
            bindings = <
&none              &none  &bl BL_DEC       &bl BL_INC       &bl BL_TOG       &kp PAGE_UP      &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &none        &none        &none
&ext_power EP_OFF  &none  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG  &kp PAGE_DOWN    &kp C_BRIGHTNESS_DEC  &bt BT_NXT         &bt BT_PRV       &switch_win  &switch_mac  &none
&ext_power EP_ON   &none  &none            &none            &none            &none            &none                 &none              &none            &none        &none        &bt BT_CLR
                                           &none            &none            &none            &none                 &none              &none
            >;
        };

        Mac_Symbols {
            bindings = <
&none  &none           &kp MAC_DE_LESS_THAN         &kp MAC_DE_GREATER_THAN       &kp MAC_DE_EXCLAMATION  &kp MAC_DE_PERCENT    &kp MAC_DE_GRAVE         &kp MAC_DE_QUESTION      &kp MAC_DE_LEFT_BRACKET  &kp MAC_DE_RIGHT_BRACKET  &none          &none
&none  &kp MAC_DE_AT   &kp MAC_DE_LEFT_PARENTHESIS  &kp MAC_DE_RIGHT_PARENTHESIS  &kp MAC_DE_EQUAL        &kp MAC_DE_PIPE       &kp MAC_DE_AMPERSAND     &kp MAC_DE_PLUS          &kp MAC_DE_LEFT_BRACE    &kp MAC_DE_RIGHT_BRACE    &kp MAC_DE_MINUS  &none
&none  &kp MAC_DE_EURO &kp MAC_DE_BACKSLASH         &kp MAC_DE_SLASH              &kp MAC_DE_ASTERISK     &kp MAC_DE_DOLLAR     &kp MAC_DE_DOUBLE_QUOTES &kp MAC_DE_SINGLE_QUOTE  &kp MAC_DE_TILDE         &kp MAC_DE_CARET          &kp MAC_DE_HASH   &none
                                                 &trans                         &trans                  &trans                &trans                   &trans                   &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Func_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };

        Mac_Func_layer {
            if-layers = <5 3>;
            then-layer = <4>;
        };
    };
};
